rules_version = '2';

// กฎนี้จำกัดสิทธิ์ไว้เฉพาะ 2 คอลเลกชันที่แอป WL-Cash ใช้เท่านั้น
// (ไม่เปิดให้อ่าน/เขียนส่วนอื่นของฐานข้อมูล)
// เหมาะสำหรับใช้งานภายในร้าน ร่วมกับการล็อกอินด้วยรหัส PIN หน้าแอปอยู่แล้ว
//
// หมายเหตุ: กฎชุดนี้ยังไม่ผูกกับผู้ใช้ (ไม่มีระบบ Login จริง) จึงเหมาะกับการใช้งาน
// ภายในทีมที่ไว้ใจกันเท่านั้น ถ้าต้องการความปลอดภัยสูงขึ้น ดูหัวข้อ
// "อัปเกรดความปลอดภัย" ใน README.md

service cloud.firestore {
  match /databases/{database}/documents {
    match /wlcash/{docId} {
      allow read, write: if true;
    }
    match /wlcash_entries/{docId} {
      allow read, write: if true;
    }
  }
}
